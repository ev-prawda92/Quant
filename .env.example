# Copy this file to .env and fill in your own key — .env itself is gitignored
# and should never be committed.
#
# Required only for wiring real market data (nwc_quant.data.MassiveProvider).
# The offline demo (`python -m nwc_quant.run`) needs neither of these — it
# runs entirely on a synthetic universe.

MASSIVE_API_KEY=your_key_here
# or, if you're using an existing Polygon.io key against Massive's
# Polygon-compatible endpoint:
# POLYGON_API_KEY=your_key_here
